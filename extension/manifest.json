{
    "manifest_version": 3,
    "name": "PricePulse Tracker",
    "version": "1.0",
    "description": "Track prices directly from your browser",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://pricepulse-project-production.up.railway.app/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon_128.png"
    },
    "icons": {
        "128": "icon_128.png"
    }
}